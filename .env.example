# ==== Aplikasi ====
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
RETURN_URL=http://localhost:3000/return

# ==== Database & Redis ====
DATABASE_URL="mysql://igate:igate_pass@localhost:3306/igate_ticketing"
REDIS_URL="redis://localhost:6379"

# ==== Auth ====
JWT_SECRET=ganti-dengan-secret-acak-min-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-secret-lain-acak-min-32-karakter
# Masa aktif sesi admin. Default 12h (access) & 7d (refresh).
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d

# ==== Bisnis ====
TICKET_PRICE=100000
MAX_TICKETS=5000
PAYMENT_EXPIRY_MINUTES=360
NIM_REGEX=^\d{10,20}$
VOUCHER_MIN_NOMINAL=10000
VOUCHER_MAX_NOMINAL=10000000
EVENT_DATE=2026-12-31
# Jumlah resmi mahasiswa angkatan 2026 (penyebut % progress punishment di dashboard)
ANGKATAN_2026_TOTAL=234

# ==== Tripay ====
TRIPAY_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CHANNELS=QRIS,BRIVA

# ==== Email ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IGATE <no-reply@igate.example>"

# ==== Discord ====
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LOG_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_URL=
DISCORD_ALERT_ROLE_ID=
DISCORD_PANITIA_ROLE_ID=
DISCORD_SUPERADMIN_ROLE_ID=
STOCK_ALERT_THRESHOLD=10
DISCORD_ADMIN_ROLE_ID=
